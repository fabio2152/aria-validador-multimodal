# Solo NOMBRES y valores locales de la maqueta. Copiar a `.env.local` (ignorado) y completar.

# El PostgreSQL 17 del `docker-compose.yml` (contenedor `aria_validador_base`).
DATABASE_URL=postgres://postgres:postgres_local@127.0.0.1:55433/validador

# MAQUETA: en ARIA la llave es POR ORGANIZACIÓN y vive cifrada en la base. Acá sale del entorno y
# la lee UN solo archivo, `lib/validador/llave.ts`, que es lo que se reemplaza al integrar.
ANTHROPIC_API_KEY=

# El servicio de ortografía del `docker-compose.yml` (contenedor `aria_validador_lenguaje`).
LANGUAGETOOL_URL=http://127.0.0.1:8010
